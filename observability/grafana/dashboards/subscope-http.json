{
  "uid": "subscope-http",
  "title": "Подписки · HTTP и Go",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "subscope",
    "operations"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Application RPS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "subscope-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(service) (rate(subscope_http_requests_total{service=~\"$service\",route!~\"/healthz|/assets/.*|/fonts/.*|/docs/.*|/grafana/.*|/prometheus/.*\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP 5xx ratio",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "subscope-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "(sum(rate(subscope_http_requests_total{service=~\"$service\",route!~\"/healthz|/assets/.*|/fonts/.*|/docs/.*|/grafana/.*|/prometheus/.*\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(subscope_http_requests_total{service=~\"$service\",route!~\"/healthz|/assets/.*|/fonts/.*|/docs/.*|/grafana/.*|/prometheus/.*\"}[$__rate_interval])),0.001)",
          "refId": "A",
          "legendFormat": "HTTP 5xx ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "title": "HTTP p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "subscope-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le,service) (rate(subscope_http_request_duration_seconds_bucket{service=~\"$service\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
