{
  "uid": "subscope-sync",
  "title": "Подписки · Синхронизация и кеш",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "subscope",
    "operations"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Published snapshot",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "subscope-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "subscope_snapshot_available{service=\"analytics-service\"}",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "WAITING",
                  "color": "orange"
                },
                "1": {
                  "text": "READY",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "title": "Snapshot age",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "subscope-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "(time() - subscope_snapshot_data_timestamp_seconds{service=\"analytics-service\"}) and on(instance,service) (subscope_snapshot_available{service=\"analytics-service\"} == 1)",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "title": "Sync cycles by result",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "subscope-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(result) (increase(subscope_sync_total{service=\"analytics-service\"}[$__range]))",
          "refId": "A",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Sync p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "subscope-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le,result) (rate(subscope_sync_duration_seconds_bucket{service=\"analytics-service\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Sync in progress",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "subscope-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "subscope_sync_in_progress{service=\"analytics-service\"}",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "IDLE",
                  "color": "orange"
                },
                "1": {
                  "text": "RUNNING",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 6,
      "title": "Source attempts incl. retries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "subscope-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(source,status) (rate(subscope_source_requests_total{service=\"analytics-service\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{source}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Source p95 to headers",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "subscope-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le,source)(rate(subscope_source_request_duration_seconds_bucket{service=\"analytics-service\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Cache lookups by layer and result",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "subscope-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(layer,result)(rate(subscope_cache_lookups_total{service=\"analytics-service\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{layer}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Redis cache hit ratio",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "subscope-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "(sum(rate(subscope_cache_lookups_total{service=\"analytics-service\",layer=\"redis\",result=\"hit\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(subscope_cache_lookups_total{service=\"analytics-service\",layer=\"redis\"}[$__rate_interval])),0.001)",
          "refId": "A",
          "legendFormat": "Redis cache hit ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
