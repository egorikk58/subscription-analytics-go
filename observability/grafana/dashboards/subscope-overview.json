    {
      "id": 10,
      "title": "API аналитики · p95",
      "description": "Оценка p95 из histogram buckets. Панели появляются по мере наблюдений, запросы не выдумываются.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "subscope-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,route)(rate(subscope_http_request_duration_seconds_bucket{service=\"analytics-service\",route=~\"/metrics/ltv/.*|/metrics/retention|/api/dashboard|/users/by-telegram/.*\"}[$__rate_interval])))",
          "legendFormat": "{{route}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Нет наблюдений",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
