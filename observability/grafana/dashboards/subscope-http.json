  ],
  "links": [
    {
      "title": "Обзор",
      "url": "/grafana/d/subscope-overview",
      "type": "link",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true
    },
    {
      "title": "HTTP и Go",
      "url": "/grafana/d/subscope-http",
      "type": "link",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true
    },
    {
      "title": "Синхронизация и кеш",
      "url": "/grafana/d/subscope-sync",
      "type": "link",
      "icon": "dashboard",
      "targetBlank": false,
