    {
      "id": 6,
      "title": "HTTP 5xx",
      "description": "Доля 5xx среди прикладных запросов. Включает инъекции ошибок mock-сервисов; при отсутствии трафика нет процента.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "subscope-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(subscope_http_requests_total{service=~\".+\",route!~\"/healthz|/assets/.*|/fonts/.*|/docs/.*|/grafana/.*|/prometheus/.*\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(subscope_http_requests_total{service=~\".+\",route!~\"/healthz|/assets/.*|/fonts/.*|/docs/.*|/grafana/.*|/prometheus/.*\"}[$__rate_interval]))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Нет трафика",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
