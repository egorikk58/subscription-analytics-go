        {
          "expr": "histogram_quantile(0.99, sum by(le,service) (rate(subscope_http_request_duration_seconds_bucket{service=~\"$service\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
