      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service)(rate(subscope_http_requests_total{service=~\".+\",route!~\"/healthz|/assets/.*|/fonts/.*|/docs/.*|/grafana/.*|/prometheus/.*\"}[$__rate_interval]))",
