# Copy to .env. Replace all example passwords before deploying.
# Passwords used in URLs must contain only URL-safe characters, or be percent-encoded.
POSTGRES_DB=subscription_analytics
POSTGRES_PASSWORD=replace_with_random_postgres_password
USERS_PASSWORD=replace_with_random_users_password
SUBSCRIPTIONS_PASSWORD=replace_with_random_subscriptions_password
PAYMENTS_PASSWORD=replace_with_random_payments_password
ANALYTICS_PASSWORD=replace_with_random_analytics_password

ANALYTICS_PORT=127.0.0.1:8080
SEED=42
# auto = seeded size 25000..100000 for a new DB; retains existing dataset size.
# Or set an exact count in 10000..100000.
USERS_COUNT=auto
HISTORY_MONTHS=24
# Fixed UTC time makes the same generator configuration reproducible.
DATASET_AS_OF=2026-11-01T00:00:00Z
SYNC_INTERVAL=10m
SYNC_TIMEOUT=2m
HTTP_REQUEST_TIMEOUT=5s
RETRY_ATTEMPTS=4

# Fault probabilities are basis points: 100 = 1%, 10000 = 100%.
# The two probabilities should add up to no more than 10000.
MOCK_DELAY=50ms
MOCK_500_BPS=100
MOCK_429_BPS=100
# Optional per-source overrides, for example USERS_MOCK_500_BPS=9000.
# Prefix any of the three MOCK_* variables with USERS_, SUBSCRIPTIONS_ or PAYMENTS_.

# Full tools stack: docker compose --profile observability up --build -d --wait
OPS_USERNAME=ops
OPS_PASSWORD=replace_with_random_operations_password
DB_VIEWER_PASSWORD=replace_with_random_viewer_password
GRAFANA_ADMIN_PASSWORD=replace_with_random_grafana_password
# Exact public base URL, without trailing slash; update when changing host/port/TLS.
PUBLIC_BASE_URL=http://localhost:8080

# Redis preserves existing keys on memory exhaustion; new cache writes fall back to PG.
REDIS_MAXMEMORY=256mb
