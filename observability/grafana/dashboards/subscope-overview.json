{
  "uid": "subscope-overview",
  "title": "Подписки · Обзор сервиса",
  "description": "Работоспособность, свежесть аналитики и технические показатели. Подробные дашборды открываются кнопками сверху.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "subscope",
    "overview",
    "operations"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Go-сервисы доступны",
      "description": "Четыре прикладных сервиса. Prometheus проверяет их private metrics listener каждые 15 секунд.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "subscope-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=~\"analytics|users|subscriptions|payments\"})",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Нет наблюдений",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 4
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Недоступно",
                  "color": "red"
                },
                "4": {
                  "text": "4 из 4",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
