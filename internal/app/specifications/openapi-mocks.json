{
  "openapi": "3.0.3",
  "info": {
    "title": "Internal mock source contracts",
    "version": "1.0.0",
    "description": "These services are deliberately not published. Try-it-out needs access from the Docker network. /plans also uses the items/has_more envelope."
  },
  "paths": {
    "/users": {
      "get": {
        "operationId": "sourceSourceUser",
        "servers": [
          {
            "url": "http://users-service:8080",
            "description": "Internal Docker network only; not reachable from the browser."
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "description": "",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1000
            }
          },
          {
            "name": "updated_since",
            "in": "query",
            "required": false,
            "description": "Inclusive updated_at cursor; stable order (updated_at,id).",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stable page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SourceUser"
                      }
                    },
                    "has_more": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "items",
                    "has_more"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "Injected rate limit",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Injected upstream failure"
          },
          "503": {
            "description": "Database unavailable"
          }
        }
      }
    },
    "/plans": {
      "get": {
        "operationId": "sourcePlan",
        "servers": [
