    {
      "id": 13,
      "title": "Redis memory utilization (when maxmemory > 0)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "subscope-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "(subscope_redis_memory_used_bytes{service=\"analytics-service\"} / subscope_redis_memory_limit_bytes{service=\"analytics-service\"}) and on(instance,service) (subscope_redis_memory_limit_bytes{service=\"analytics-service\"} > 0)",
          "refId": "A",
          "legendFormat": "Redis memory"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
